#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF_USAGE'
Usage:
  ./scripts/make_clean [--dry-run]
  ./make_clean [--dry-run]

Clean generated CMake artifacts for the standard local presets.

Runs:
  cmake --build --preset dev --target clean
  cmake --build --preset release --target clean

This does not remove data/, dist/, config files, or source files.
EOF_USAGE
}

dry_run="false"
while [[ $# -gt 0 ]]; do
  case "${1}" in
    --help|-h)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run="true"
      shift
      ;;
    *)
      echo "Unknown argument: ${1}" >&2
      usage >&2
      exit 1
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"

run_clean() {
  local preset="${1}"
  local build_dir="${repo_root}/build/${preset}"

  # rm -rf e mais robusto que "cmake --build --target clean" porque o target
  # clean exige configure previo (falha em fresh checkout). O Ninja nao tem
  # estado incremental que sobre-viva a remocao do diretorio de build.
  if [[ "${dry_run}" == "true" ]]; then
    printf 'Would run: rm -rf %q\n' "${build_dir}"
    return
  fi

  if [[ -d "${build_dir}" ]]; then
    echo "Cleaning CMake preset: ${preset} (rm -rf ${build_dir})"
    rm -rf "${build_dir}"
  else
    echo "Skipping preset ${preset}: ${build_dir} not present (nothing to clean)."
  fi
}

cd "${repo_root}"
run_clean dev
run_clean release
