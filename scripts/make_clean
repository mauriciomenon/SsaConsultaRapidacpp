#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF_USAGE'
Usage:
  ./scripts/make_clean [--dry-run]
  ./make_clean [--dry-run]

Clean all generated CMake artifacts under build/.

Runs:
  rm -rf <repo>/build

This preserves .deps-cache/, data/, dist/, packaging/, config files, and source files.
EOF_USAGE
}

dry_run="false"
while [[ $# -gt 0 ]]; do
  case "${1}" in
    --help|-h)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run="true"
      shift
      ;;
    *)
      echo "Unknown argument: ${1}" >&2
      usage >&2
      exit 1
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"

cd "${repo_root}"
build_root="${repo_root}/build"
if [[ "${dry_run}" == "true" ]]; then
  printf 'Would run: rm -rf -- %q\n' "${build_root}"
elif [[ -d "${build_root}" ]]; then
  echo "Cleaning all CMake build artifacts: ${build_root}"
  rm -rf -- "${build_root}"
else
  echo "Skipping build cleanup: ${build_root} not present."
fi
